{
    "name": "dicr/yii2-settings",
    "type": "yii2-extension",
    "license": "GPL-3.0-or-later",
    "description": "Хранение настроек приложения в Yii2",
    "keywords": ["dicr", "yii2", "settings"],
    "homepage": "https://gitlab.com/dicr/yii2-settings",
    "authors": [
        {
            "name": "Igor Tarasov",
            "email": "develop@dicr.org",
            "homepage": "https://dicr.org",
            "role": "developer"
        }
    ],
    "support": {
        "source": "https://gitlab.com/dicr/yii2-settings.git"
    },
    "autoload": {
        "psr-4": {
            "dicr\\settings\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "dicr\\tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "require": {
        "php": ">=8.3",
        "yiisoft/yii2": "^2.0.54|^22"
    },
    "suggest": {
        "ext-yaml": "Needed for YML settings store"
    },
    "require-dev": {
        "ext-sqlite3": "*",
        "ext-yaml": "*",
        "roave/security-advisories": "dev-latest",
        "phpunit/phpunit": "^11.0|^12.0|^13.0",
        "phpstan/phpstan": "^2.0",
        "yiisoft/yii2-coding-standards": "^3.0"
    },
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true,
            "composer/installers": true
        }
    },
    "repositories": [
        {"type": "composer", "url": "https://asset-packagist.org"}
    ]
}
